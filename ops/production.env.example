NODE_ENV=production
PORT=3001
APP_BASE_URL=https://catat.example.com
SESSION_SECRET=replace-with-unique-random-secret-at-least-32-characters
SESSION_TTL_HOURS=24
TRUST_PROXY_LOOPBACK=true
DATABASE_URL=postgresql://catat_runtime:REPLACE_URL_ENCODED_PASSWORD@127.0.0.1:5432/catat_production?schema=public
CSV_MAX_DAYS=366
CSV_MAX_ROWS=10000
