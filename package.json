{
  "name": "api",
  "packageManager": "pnpm@10.33.1",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "format": "prettier --write \"src/**/*.ts\" \"scripts/*.{ts,mjs}\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "oxlint --type-aware src/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "pnpm build && node scripts/verify-foundation.mjs && node scripts/verify-auth-regressions.mjs && node scripts/verify-master-data.mjs && node scripts/verify-fine-cases.mjs && node scripts/verify-payments.mjs && node scripts/verify-reporting.mjs",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "typecheck": "tsc --noEmit",
    "admin:bootstrap": "tsx scripts/bootstrap-admin.ts",
    "openapi:export": "pnpm build && node scripts/export-openapi.mjs",
    "prisma:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "test:seed": "pnpm build && tsx scripts/verify-initial-seed.ts",
    "test:uuid": "pnpm test:seed && node scripts/verify-uuid-migration.mjs",
    "test:browser:server": "pnpm build && node scripts/serve-browser-qa.mjs",
    "test:performance": "pnpm build && node scripts/verify-performance.mjs",
    "test:recovery": "pnpm build && node scripts/verify-restore.mjs",
    "test:https:server": "node scripts/rehearse-https.mjs",
    "backup:create": "node scripts/ops/backup.mjs",
    "backup:restore": "node scripts/ops/restore.mjs"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.1.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/swagger": "^12.1.2",
    "@nestjs/throttler": "^6.8.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "argon2": "^0.45.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "helmet": "^8.3.0",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "uuid": "14.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "dotenv": "^18.0.10",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.4.2",
    "prisma": "^7.10.1",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vitest": "^4.1.2"
  },
  "pnpm": {
    "overrides": {
      "@prisma/config>effect": "3.22.1"
    }
  }
}
