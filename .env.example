DATABASE_URL="postgresql://catat_denda:catat_denda_dev@localhost:5433/catat_denda?schema=public"
PORT=3001
WEB_ORIGIN="http://localhost:3000"

APP_BASE_URL=http://localhost:3000
SESSION_SECRET=replace-with-random-secret-at-least-32-characters
SESSION_TTL_HOURS=24
TRUST_PROXY_LOOPBACK=false
# Set when the public API domain differs from the frontend origin.
# API_PUBLIC_URL=https://api-catat-denda-berkop.geats.web.id

# Provisioning satu kali: suplai password lewat environment sementara.
# ADMIN_BOOTSTRAP_USERNAME=admin
# ADMIN_BOOTSTRAP_EMAIL opsional. Jangan simpan password bootstrap di Git.

# Seeder initial: username defyana; password wajib hanya jika akun belum ada.
# SEED_ADMIN_PASSWORD disuplai melalui env/secret manager, tidak disimpan di Git.

# CSV exports fail explicitly above either bound; no silent truncation.
CSV_MAX_DAYS=366
CSV_MAX_ROWS=10000
