log_format catat_denda '$remote_addr [$time_local] "$request_method $uri $server_protocol" $status $body_bytes_sent';
server {
    listen 8080;
    listen [::]:8080;
    server_name __BACKEND_DOMAIN__;
    server_tokens off;
    client_max_body_size 256k;
    access_log /var/log/nginx/catat-denda.access.log catat_denda;
    error_log /var/log/nginx/catat-denda.error.log;
    location = /api/v1/health/ready { return 404; }
    location = /api/v1/health/ready/ { return 404; }
    location /api/v1/ {
        proxy_pass http://127.0.0.1:3001;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Connection "";
        proxy_next_upstream off;
        proxy_read_timeout 60s;
        proxy_cache off;
    }
    location / { return 404; }
}
